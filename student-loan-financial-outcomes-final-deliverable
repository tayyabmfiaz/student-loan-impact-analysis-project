plt.xlabel("Race/Ethnicity")
# label y axis as median education loans taken out
plt.ylabel("Median Education Loans (in thousands of dollars)")
# show the complete chart with all labels
plt.show()
# filtering the combined dataframe to only include the race and ethnicity groups
race_data = scf_combined[scf_combined["group_label"].isin(race_groups)].copy()
# creating a new column that calculates education loan debt as a share of total net worth
race_data["edu_to_networth"] = (race_data["Education_Installment_Loans"] / race_data["Net_Worth"]).round(4)
# filtering to only 2022 to see the most recent snapshot
race_2022_bias = race_data[race_data["year"] == 2022]
# showing the results for each racial group
race_2022_bias[["group_label", "Education_Installment_Loans", "Net_Worth", "edu_to_networth"]]
