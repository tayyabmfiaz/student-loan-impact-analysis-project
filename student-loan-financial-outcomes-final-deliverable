race_groups = ['White, non-Hispanic', 'Black, non-Hispanic', 'Hispanic', 'Other']
race_2022 = scf_combined[(scf_combined["group_label"].isin(race_groups))]
# filter for only the year 2022
race_2022 = race_2022[race_2022["year"] == 2022]
# create bar chart with group_label and education loans as the two variables
plt.bar(race_2022["group_label"], race_2022["Education_Installment_Loans"])
# create title for barchart
plt.title("Median Education Loan Debt by Race/Ethnicity in 2022")
